def play_tv_alpha_version_codes
  google_play_track_version_codes(track: "tv:alpha")
end

desc "Print the latest version code on Android TV closed testing (tv:alpha)"
lane :last_version_code do
  last = play_tv_alpha_version_codes.max || 0
  puts("PLAY_VERSION_CODE=#{last}")
  last
end

desc "Print the next version code for Android TV closed testing (tv:alpha)"
lane :next_version_code do
  last = play_tv_alpha_version_codes.max || 0
  next_code = last + 1
  puts("PLAY_VERSION_CODE=#{last}")
  puts("PLAY_NEXT_VERSION_CODE=#{next_code}")
  next_code
end

desc "Submit a new build to Play Store Android TV production"
lane :deploy do
  upload_to_play_store(
      track: "tv:production",
      skip_upload_metadata: true,
      skip_upload_apk: true,
      skip_upload_screenshots: true,
      skip_upload_images: true,
      aab: "../build/app/outputs/bundle/playRelease/app-play-release.aab"
  )
end

desc "Submit a new build to Play Store closed testing (Android TV alpha track)"
lane :deploy_closed do
  upload_to_play_store(
      track: "tv:alpha",
      skip_upload_metadata: true,
      skip_upload_apk: true,
      skip_upload_screenshots: true,
      skip_upload_images: true,
      aab: "../build/app/outputs/bundle/playRelease/app-play-release.aab"
  )
end

desc "Promote previous internal version to production"
lane :promote do
  upload_to_play_store(
      track: "internal",
      track_promote_to: "production"
  )
end

desc "Promote previous closed testing version to production (Android TV)"
lane :promote_closed do
  upload_to_play_store(
      track: "tv:alpha",
      track_promote_to: "tv:production"
  )
end
