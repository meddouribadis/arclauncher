def play_tv_max_version_code
  ["tv:alpha", "tv:production"].map do |track|
    code = google_play_track_version_codes(track: track).max || 0
    puts("PLAY_TRACK_VERSION_CODE #{track}=#{code}")
    code
  end.max
end

desc "Print the highest version code used on Android TV closed testing (tv:alpha) and production (tv:production)"
lane :last_version_code do
  last = play_tv_max_version_code
  puts("PLAY_VERSION_CODE=#{last}")
  last
end

desc "Print the next version code for Android TV (above both tv:alpha and tv:production)"
lane :next_version_code do
  last = play_tv_max_version_code
  next_code = last + 1
  puts("PLAY_VERSION_CODE=#{last}")
  puts("PLAY_NEXT_VERSION_CODE=#{next_code}")
  next_code
end

desc "Submit a new build to Play Store Android TV production"
lane :deploy do
  upload_to_play_store(
      track: "tv:production",
      skip_upload_metadata: true,
      skip_upload_apk: true,
      skip_upload_screenshots: true,
      skip_upload_images: true,
      aab: "../build/app/outputs/bundle/playRelease/app-play-release.aab"
  )
end

desc "Submit a new build to Play Store closed testing (Android TV alpha track, or custom track via track:)"
lane :deploy_closed do |options|
  target_track = options[:track] || "tv:alpha"
  upload_to_play_store(
      track: target_track,
      skip_upload_metadata: true,
      skip_upload_apk: true,
      skip_upload_screenshots: true,
      skip_upload_images: true,
      aab: "../build/app/outputs/bundle/playRelease/app-play-release.aab"
  )
end

desc "Promote previous internal version to production"
lane :promote do
  upload_to_play_store(
      track: "internal",
      track_promote_to: "production"
  )
end

desc "Promote previous closed testing version to production (Android TV)"
lane :promote_closed do
  upload_to_play_store(
      track: "tv:alpha",
      track_promote_to: "tv:production"
  )
end
